#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <64 65 63>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none             &none     &none     &none     &none                      &none                                              &none          &none  &none      &none     &none      &none
&mt ESC TAB       &kp Q     &kp W     &kp E     &kp R                      &kp T                                              &kp Y          &kp U  &kp I      &kp O     &kp P      &kp MINUS
&kp LEFT_CONTROL  &kp A     &kp S     &kp D     &kp F                      &kp G        &none        &none                    &kp H          &kp J  &kp K      &kp L     &kp SEMI   &kp SQT
&kp LSHFT         &kp Z     &kp X     &kp C     &kp V                      &kp B        &kp LALT     &kp RALT                 &kp N          &kp M  &kp COMMA  &kp DOT   &kp SLASH  &mt RSHFT GRAVE
&kp LGUI          &kp LGUI  &kp LGUI  &kp LGUI  &lt 3 LANG_ZENKAKUHANKAKU  &lt 2 SPACE  &lt 1 SPACE  &mt RIGHT_COMMAND ENTER  &kp BACKSPACE  &none  &none      &kp RGUI  &kp RGUI   &kp RGUI
            >;
        };

        layer_1 {
            bindings = <
&none   &none    &none    &none   &none   &none                    &none   &none   &none   &none   &none          &none
&trans  &kp N1   &kp N2   &kp N3  &kp N4  &kp N5                   &kp N6  &kp N7  &kp N8  &kp N9  &kp N0         &kp EQUAL
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &none   &none   &trans  &trans  &trans  &trans  &kp LBKT       &kp RBKT
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &kp BACKSLASH  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans  &trans  &trans  &none   &none   &trans  &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&none   &none   &none      &none   &none      &none                   &none   &none      &none  &none      &none   &none
&trans  &none   &none      &none   &none      &none                   &none   &none      &none  &none      &none   &trans
&trans  &none   &mkp LCLK  &none   &mkp RCLK  &none   &none   &none   &none   &mkp LCLK  &none  &mkp RCLK  &none   &trans
&trans  &none   &none      &none   &none      &none   &trans  &trans  &none   &none      &none  &none      &none   &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans  &trans  &trans  &none      &none  &trans     &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&none   &none   &none     &none       &none      &none                   &none   &none     &none     &none      &none   &none
&trans  &none   &none     &kp UP      &none      &none                   &none   &none     &kp UP    &none      &none   &trans
&trans  &none   &kp LEFT  &kp DOWN    &kp RIGHT  &none   &none   &none   &none   &kp LEFT  &kp DOWN  &kp RIGHT  &none   &trans
&trans  &none   &none     &none       &none      &none   &trans  &trans  &none   &none     &none     &none      &none   &trans
&trans  &trans  &trans    &bt BT_NXT  &trans     &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans  &trans
            >;
        };

        bn {
            bindings = <
&none   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans
            >;
        };
    };
};

&pointing_listener {
    scroller {
        layers = <3>;
        input-processors = <
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            &zip_scroll_scaler 1 4
        >;
    };
};
